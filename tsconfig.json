{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/types.ts",
    "src/store.ts",
    "src/terminal.ts",
    "src/migration.ts",
    "src/git.ts",
    "src/main.ts",
    "src/preload.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
